rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'matheusmain2018@gmail.com';
    }

    function isOwner(userId) {
      return (isSignedIn() && request.auth.uid == userId) || isAdmin();
    }

    function isDataOwner() {
      return (isSignedIn() && request.resource.data.userId == request.auth.uid) || isAdmin();
    }
    
    function existingDataOwner() {
      return (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    match /meals/{id} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isDataOwner();
      allow update, delete: if existingDataOwner();
    }

    match /workouts/{id} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isDataOwner();
      allow update, delete: if existingDataOwner();
    }

    match /supplements/{id} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isDataOwner();
      allow update, delete: if existingDataOwner();
    }

    match /cardios/{id} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isDataOwner();
      allow update, delete: if existingDataOwner();
    }

    match /evolution/{id} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isDataOwner();
      allow update, delete: if existingDataOwner();
    }

    match /trainingAnalyses/{id} {
      allow read, write: if (isSignedIn() && id.split('_')[0] == request.auth.uid) || isAdmin();
    }
  }
}
